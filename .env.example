PORT=3000

# Domain pointed at this server (DNS A record -> server IP). Used by Caddy
# in docker-compose.yml to get an auto-renewed HTTPS cert.
DOMAIN=pos.yourdomain.com

# Public HTTPS URL this server is reachable at (https://$DOMAIN once deployed).
# This is the URL you give GBPrimePay for verification, and its webhook needs
# to reach ${PUBLIC_BASE_URL}/api/webhooks/gbprimepay
PUBLIC_BASE_URL=https://pos.yourdomain.com

# "sandbox" while testing, "production" once you have live keys and are ready for the event
GBPRIMEPAY_ENV=sandbox
GBPRIMEPAY_TOKEN=
GBPRIMEPAY_PUBLIC_KEY=
GBPRIMEPAY_SECRET_KEY=

# Order auto-cancels if unpaid after this many minutes
ORDER_EXPIRY_MINUTES=5

# Menu prices in THB (flat price per item, no variants)
PRICE_BEER=80
PRICE_REGENCY=150

# Google service account (Sheets API) for accounting log.
# In Docker this path is fixed by docker-compose.yml's volume mount - leave as-is;
# just put your real service-account.json next to docker-compose.yml on the server.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/app/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:F
