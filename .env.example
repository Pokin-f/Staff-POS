PORT=3000

# Plan B / demo mode. true = mock the gateway (placeholder QR that never
# auto-confirms) and skip Google Sheets, so you can rehearse the full
# checkout -> QR -> slip flow with no keys. MUST be false for the live event.
DEMO_MODE=false

# Payment mode.
#   static_qr = show the fixed real PromptPay QR at public/images/promptpay-qr.jpg.
#               A static QR encodes NO amount and NO order reference, so the
#               customer types the total into their banking app and staff confirm
#               every order by capturing the slip photo. No GBPrimePay keys needed.
#   gateway   = ask GBPrimePay for a per-order QR with the exact amount, which can
#               auto-confirm via status polling + webhook. Needs the keys below.
PAYMENT_MODE=static_qr
STATIC_QR_IMAGE=/images/test.jpg

# Domain pointed at this server (DNS A record -> server IP). Used by Caddy
# in docker-compose.yml to get an auto-renewed HTTPS cert.
DOMAIN=pos.yourdomain.com

# Public HTTPS URL this server is reachable at (https://$DOMAIN once deployed).
# This is the URL you give GBPrimePay for verification, and its webhook needs
# to reach ${PUBLIC_BASE_URL}/api/webhooks/gbprimepay
PUBLIC_BASE_URL=https://pos.yourdomain.com

# "sandbox" while testing, "production" once you have live keys and are ready for the event
GBPRIMEPAY_ENV=sandbox
GBPRIMEPAY_TOKEN=
GBPRIMEPAY_PUBLIC_KEY=
GBPRIMEPAY_SECRET_KEY=

# Order auto-cancels if unpaid after this many minutes
ORDER_EXPIRY_MINUTES=5

# Crew working the till, comma-separated. Staff pick themselves before the
# table on every order and the name is written to the "Collected By" column of
# the sheet. Left empty, the picker falls back to Staff 1..4 and says so at boot.
STAFF_NAMES=Ping,Nok,Bee,Golf

# Menu prices in THB (flat price per item, no variants)
PRICE_BEER=390
PRICE_REGENCY=590

# Fallback only. The table grid is built from the imported seating list
# (data/guests.json — run `node scripts/import-guests.js`), so this is used
# only when no seating data has been imported.
TABLE_COUNT=30

# Google service account (Sheets API) for accounting log.
# In Docker this path is fixed by docker-compose.yml's volume mount - leave as-is;
# just put your real service-account.json next to docker-compose.yml on the server.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/app/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:O
